# PostgreSQL connection string (create the database first, e.g. in pgAdmin:
# CREATE DATABASE reserve_plate;)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/reserve_plate?schema=public"

# API binds to loopback only — the data it holds is personal.
PORT=3001
HOST=127.0.0.1

# Origins allowed to call the API (the Next.js dev server).
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Timezone the cron expressions are evaluated in.
SCHEDULE_TIMEZONE=Asia/Bangkok

# Stop auto-retrying (302/500 from DLT) after this many attempts. 0 = unlimited
# (the original behaviour; use the Stop button in the UI to cancel).
MAX_ATTEMPTS=0
