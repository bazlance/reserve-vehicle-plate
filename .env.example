# Vehicle body / chassis number (printed on the vehicle registration book)
DLT_R_BODYNUMBER=

# Car brand — must match one of the <select id="r_brand"> option values on
# the DLT reservation form exactly (e.g. BMW, TOYOTA, HONDA). The app
# validates this against the live page and will fail fast if it doesn't match.
DLT_R_BRAND=

# Contact phone number (10 digits, no dashes)
DLT_R_TEL=

# Desired 4-digit plate number to request. Must fall within the number range
# shown on the reservation page for the current round (e.g. 4001-6000).
DLT_DESIRED_NUMBER=

# Car type: 1 = sedan / 4-door pickup, 2 = van, 3 = pickup
DLT_CAR_TYPE=1

# Applicant type: 1 = individual, 2 = corporate / foreign
DLT_PERS=1
